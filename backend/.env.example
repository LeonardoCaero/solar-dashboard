# From https://developer-api.isolarcloud.com
SUNGROW_APP_KEY=
SUNGROW_SECRET_KEY=
SUNGROW_RSA_PUBLIC_KEY=
SUNGROW_USERNAME=
SUNGROW_PASSWORD=
# api_call_password: only set this if login fails with a decrypt error —
# some portal apps use a separate encryption password instead of the
# account password. Leave unset to default to SUNGROW_PASSWORD.
# SUNGROW_API_CALL_PASSWORD=

SUNGROW_REGION=europe
# SUNGROW_PLANT_ID=  # only needed if your account has more than one plant

CORS_ORIGINS=http://localhost:5173
